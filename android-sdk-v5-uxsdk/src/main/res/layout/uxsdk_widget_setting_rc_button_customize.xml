<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:background="@color/uxsdk_black"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/uxsdk_16_dp"
            android:text="@string/uxsdk_setting_ui_cutomize_button_title"
            android:textColor="@color/uxsdk_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/buttonC1Selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/uxsdk_20_dp"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/buttonC2Selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/uxsdk_10_dp"
            app:layout_constraintTop_toBottomOf="@id/buttonC1Selection" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/buttonC3Selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/uxsdk_10_dp"
            app:layout_constraintTop_toBottomOf="@id/buttonC2Selection" />

        <TextView
            android:id="@+id/titleButtonLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/uxsdk_16_dp"
            android:text="@string/uxsdk_setting_ui_customize_button_left_title"
            android:textColor="@color/uxsdk_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonC3Selection" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/buttonL1Selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/uxsdk_20_dp"
            app:layout_constraintTop_toBottomOf="@id/titleButtonLeft" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/buttonL2Selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/uxsdk_10_dp"
            app:layout_constraintTop_toBottomOf="@id/buttonL1Selection" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/buttonL3Selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/uxsdk_10_dp"
            app:layout_constraintTop_toBottomOf="@id/buttonL2Selection" />

        <View
            android:id="@+id/divider_left_right"
            android:layout_width="match_parent"
            android:layout_height="@dimen/uxsdk_1_dp"
            android:layout_marginTop="@dimen/uxsdk_16_dp"
            android:background="@color/uxsdk_gray"
            app:layout_constraintTop_toBottomOf="@id/buttonL3Selection" />

        <TextView
            android:id="@+id/titleButtonRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/uxsdk_16_dp"
            android:text="@string/uxsdk_setting_ui_customize_button_right_title"
            android:textColor="@color/uxsdk_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_left_right" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/buttonR1Selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/uxsdk_20_dp"
            app:layout_constraintTop_toBottomOf="@id/titleButtonRight" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/buttonR2Selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/uxsdk_10_dp"
            app:layout_constraintTop_toBottomOf="@id/buttonR1Selection" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/buttonR3Selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/uxsdk_10_dp"
            app:layout_constraintTop_toBottomOf="@id/buttonR2Selection" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/uxsdk_1_dp"
            android:layout_marginTop="@dimen/uxsdk_16_dp"
            android:background="@color/uxsdk_gray"
            app:layout_constraintTop_toBottomOf="@id/buttonR3Selection" />

        <TextView
            android:id="@+id/titleButton5D"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/uxsdk_16_dp"
            android:text="@string/uxsdk_setting_ui_cutomize_button_5d_title"
            android:textColor="@color/uxsdk_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/button5DUPSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/uxsdk_20_dp"
            app:layout_constraintTop_toBottomOf="@id/titleButton5D" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/button5DDownSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/uxsdk_10_dp"
            app:layout_constraintTop_toBottomOf="@id/button5DUPSelection" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/button5DLeftSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/uxsdk_10_dp"
            app:layout_constraintTop_toBottomOf="@id/button5DDownSelection" />

        <dji.v5.ux.remotecontroller.customiztion.CustomSelectionWidget
            android:id="@+id/button5DRightSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/uxsdk_10_dp"
            app:layout_constraintTop_toBottomOf="@id/button5DLeftSelection" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/cButtonGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="title,buttonC1Selection,buttonC2Selection,buttonC3Selection" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/leftButtonGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="titleButtonLeft,buttonL1Selection,buttonL2Selection,buttonL3Selection" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/rightButtonGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="divider_left_right,titleButtonRight,buttonR1Selection,buttonR2Selection,buttonR3Selection" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
